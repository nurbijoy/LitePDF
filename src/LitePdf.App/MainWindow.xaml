<Window x:Class="LitePdf.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:viewer="clr-namespace:LitePdf.App.Viewer"
        xmlns:vm="clr-namespace:LitePdf.App.ViewModels"
        xmlns:views="clr-namespace:LitePdf.App.Views"
        xmlns:infra="clr-namespace:LitePdf.App.Infrastructure"
        Style="{StaticResource AppWindow}"
        Title="{Binding WindowTitle}"
        Icon="Assets/LitePDF.ico"
        Width="1280" Height="860" MinWidth="760" MinHeight="480"
        AllowDrop="True">

    <Window.Resources>
        <Style x:Key="EmptyStateTitle" TargetType="TextBlock" BasedOn="{StaticResource SectionTitle}">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,12,0,4"/>
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Brush.Surface}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="4" Direction="270" Opacity="0.16"/>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition x:Name="CommandRow" Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition x:Name="StatusRow" Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ===== Command bar ===== -->
        <Border x:Name="CommandBar" Grid.Row="0" Background="{DynamicResource Brush.Chrome}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1" Padding="6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <ToggleButton Style="{StaticResource IconButton}" Content="&#xE700;" IsChecked="{Binding IsSidebarOpen}" IsEnabled="{Binding HasDocument}" ToolTip="Show or hide the sidebar (F4)" AutomationProperties.Name="Sidebar"/>
                    <Button Style="{StaticResource IconButton}" Content="&#xE8E5;" Click="Open_Click" ToolTip="Open (Ctrl+O)" AutomationProperties.Name="Open"/>
                    <Button Style="{StaticResource IconButton}" Content="&#xE74E;" Click="Save_Click" IsEnabled="{Binding CanSave}" ToolTip="Save (Ctrl+S)" AutomationProperties.Name="Save"/>
                    <Button Style="{StaticResource IconButton}" Content="&#xE749;" Click="Print_Click" IsEnabled="{Binding HasDocument}" ToolTip="Print (Ctrl+P)" AutomationProperties.Name="Print"/>
                    <Border Style="{StaticResource ToolbarSeparator}"/>
                    <StackPanel Orientation="Horizontal" IsEnabled="{Binding HasDocument}">
                        <RadioButton GroupName="Tool" Style="{StaticResource IconButton}" Content="&#xE8D2;" IsChecked="{Binding IsSelectTool}" ToolTip="Select text (V)" AutomationProperties.Name="Select text tool"/>
                        <RadioButton GroupName="Tool" Style="{StaticResource IconButton}" Content="&#xE7C9;" IsChecked="{Binding IsHandTool}" ToolTip="Hand tool – drag to scroll (H)" AutomationProperties.Name="Hand tool"/>
                        <RadioButton GroupName="Tool" Style="{StaticResource IconButton}" Content="&#xE8B3;" IsChecked="{Binding IsRegionTool}" ToolTip="Select an area to copy or recognize its text (R)" AutomationProperties.Name="Area tool"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" IsEnabled="{Binding HasDocument}">
                    <Button Style="{StaticResource IconButton}" Content="&#xE70E;" Click="PreviousPage_Click" ToolTip="Previous page" AutomationProperties.Name="Previous page"/>
                    <TextBox x:Name="PageBox" Width="54" Padding="4,4" HorizontalContentAlignment="Center" TextAlignment="Center"
                             Text="{Binding PageNumberText, UpdateSourceTrigger=Explicit}" KeyDown="PageBox_KeyDown" LostKeyboardFocus="PageBox_LostKeyboardFocus"
                             GotKeyboardFocus="SelectAllOnFocus" ToolTip="Go to page (Ctrl+G)" AutomationProperties.Name="Page number"/>
                    <TextBlock Text="{Binding PageCountText}" VerticalAlignment="Center" Margin="8,0,4,0" Foreground="{DynamicResource Brush.TextSecondary}"/>
                    <Button Style="{StaticResource IconButton}" Content="&#xE70D;" Click="NextPage_Click" ToolTip="Next page" AutomationProperties.Name="Next page"/>
                    <Border Style="{StaticResource ToolbarSeparator}"/>
                    <Button Style="{StaticResource IconButton}" Content="&#xE71F;" Click="ZoomOut_Click" ToolTip="Zoom out (Ctrl+−)" AutomationProperties.Name="Zoom out"/>
                    <Button x:Name="ZoomMenuButton" Style="{StaticResource ToolbarButton}" MinWidth="78" Click="ZoomMenu_Click" ToolTip="Zoom options" AutomationProperties.Name="Zoom options">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding ZoomText}" VerticalAlignment="Center"/>
                            <TextBlock Text="&#xE70D;" Style="{StaticResource Icon}" FontSize="9" Margin="8,1,0,0"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource IconButton}" Content="&#xE8A3;" Click="ZoomIn_Click" ToolTip="Zoom in (Ctrl+=)" AutomationProperties.Name="Zoom in"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource IconButton}" Click="Highlight_Click" IsEnabled="{Binding CanAnnotate}" ToolTip="Highlight selected text (Ctrl+H)" AutomationProperties.Name="Highlight">
                        <Grid Width="20" Height="22">
                            <TextBlock Text="&#xE7E6;" Style="{StaticResource Icon}" VerticalAlignment="Top" Margin="0,1,0,0"/>
                            <Border Height="3" CornerRadius="1.5" VerticalAlignment="Bottom" Background="{Binding HighlightBrush}"/>
                        </Grid>
                    </Button>
                    <Button x:Name="MarkupMenuButton" Style="{StaticResource IconButton}" Width="18" Margin="-2,0,1,0" FontSize="9" Content="&#xE70D;" Click="MarkupMenu_Click"
                            IsEnabled="{Binding CanAnnotate}" ToolTip="Highlight color, underline, strikethrough and notes" AutomationProperties.Name="Markup options"/>
                    <Button x:Name="OcrMenuButton" Style="{StaticResource ToolbarButton}" Click="OcrMenu_Click" IsEnabled="{Binding HasDocument}" ToolTip="Recognize text in scanned pages and images" AutomationProperties.Name="Recognize text">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xEE6F;" Style="{StaticResource Icon}"/>
                            <TextBlock Text="Recognize text" Margin="8,0,0,0" VerticalAlignment="Center"/>
                            <TextBlock Text="&#xE70D;" Style="{StaticResource Icon}" FontSize="9" Margin="8,1,0,0"/>
                        </StackPanel>
                    </Button>
                    <Border Style="{StaticResource ToolbarSeparator}"/>
                    <Button Style="{StaticResource IconButton}" Content="&#xE721;" Click="Search_Click" IsEnabled="{Binding HasDocument}" ToolTip="Search (Ctrl+F)" AutomationProperties.Name="Search"/>
                    <Button x:Name="MoreMenuButton" Style="{StaticResource IconButton}" Content="&#xE712;" Click="MoreMenu_Click" ToolTip="More options" AutomationProperties.Name="More options"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== Body ===== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="RailColumn" Width="Auto"/>
                <ColumnDefinition x:Name="SidebarColumn" Width="260" MinWidth="0" MaxWidth="560"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Navigation rail -->
            <Border x:Name="Rail" Background="{DynamicResource Brush.Chrome}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,1,0" Padding="4,6"
                    Visibility="{Binding HasDocument, Converter={StaticResource BoolToVisibility}}">
                <DockPanel>
                    <Button DockPanel.Dock="Bottom" Style="{StaticResource IconButton}" Width="40" Height="40" Content="&#xE713;" Click="Settings_Click" ToolTip="Settings" AutomationProperties.Name="Settings"/>
                    <StackPanel>
                        <RadioButton GroupName="Panel" Style="{StaticResource RailButton}" Content="&#xE8A5;" Tag="Documents" IsChecked="{Binding IsDocumentsPanel, Mode=OneWay}" Click="RailButton_Click" ToolTip="Open documents (Ctrl+T)" AutomationProperties.Name="Open documents"/>
                        <RadioButton GroupName="Panel" Style="{StaticResource RailButton}" Content="&#xE8A9;" Tag="Thumbnails" IsChecked="{Binding IsThumbnailsPanel, Mode=OneWay}" Click="RailButton_Click" ToolTip="Pages" AutomationProperties.Name="Pages"/>
                        <RadioButton GroupName="Panel" Style="{StaticResource RailButton}" Content="&#xE8FD;" Tag="Chapters" IsChecked="{Binding IsChaptersPanel, Mode=OneWay}" Click="RailButton_Click" ToolTip="Chapters" AutomationProperties.Name="Chapters"/>
                        <RadioButton GroupName="Panel" Style="{StaticResource RailButton}" Content="&#xE721;" Tag="Search" IsChecked="{Binding IsSearchPanel, Mode=OneWay}" Click="RailButton_Click" ToolTip="Search" AutomationProperties.Name="Search panel"/>
                        <RadioButton GroupName="Panel" Style="{StaticResource RailButton}" Content="&#xE90A;" Tag="Annotations" IsChecked="{Binding IsAnnotationsPanel, Mode=OneWay}" Click="RailButton_Click" ToolTip="Annotations" AutomationProperties.Name="Annotations"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Sidebar -->
            <Border x:Name="Sidebar" Grid.Column="1" Background="{DynamicResource Brush.Chrome}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <DockPanel Margin="16,14,16,10">
                        <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Width="28" Height="28" Content="&#xE710;"
                                Click="NewTab_Click" ToolTip="New tab (Ctrl+T)" AutomationProperties.Name="New tab"
                                Visibility="{Binding IsDocumentsPanel, Converter={StaticResource BoolToVisibility}}"/>
                        <TextBlock Text="{Binding SidebarTitle}" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/>
                    </DockPanel>

                    <!-- Documents -->
                    <Grid Grid.Row="1" Visibility="{Binding IsDocumentsPanel, Converter={StaticResource BoolToVisibility}}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                            <ItemsControl x:Name="SidebarTabList" ItemsSource="{Binding Tabs}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="vm:DocumentTab">
                                        <Border x:Name="DocItemBd" Margin="8,2,8,2" Padding="10,8" CornerRadius="6"
                                                BorderThickness="1" Cursor="Hand" ToolTip="{Binding FilePath}"
                                                PreviewMouseLeftButtonDown="TabItem_PreviewMouseLeftButtonDown"
                                                PreviewMouseDown="TabItem_PreviewMouseDown">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="Transparent"/>
                                                    <Setter Property="BorderBrush" Value="Transparent"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource Brush.Surface}"/>
                                                            <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderStrong}"/>
                                                        </DataTrigger>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding IsActive}" Value="False"/>
                                                                <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsMouseOver}" Value="True"/>
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Background" Value="{DynamicResource Brush.Hover}"/>
                                                        </MultiDataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Border.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="Close tab" InputGestureText="Ctrl+W" Click="TabContextClose_Click"/>
                                                    <MenuItem Header="Close other tabs" Click="TabContextCloseOthers_Click"/>
                                                    <MenuItem Header="Close all tabs" Click="TabContextCloseAll_Click"/>
                                                </ContextMenu>
                                            </Border.ContextMenu>
                                            <Grid VerticalAlignment="Center">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Document icon -->
                                                <TextBlock Grid.Column="0" Text="&#xE8A5;" FontSize="15" VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource Icon}">
                                                            <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                    <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>

                                                <!-- Unsaved dot indicator -->
                                                <TextBlock Grid.Column="1" Text="●" FontSize="9" Margin="4,0,0,0" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource Brush.Accent}"
                                                           Visibility="{Binding IsDirty, Converter={StaticResource BoolToVisibility}}"/>

                                                <!-- Document title -->
                                                <TextBlock Grid.Column="2" Text="{Binding Title}"
                                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                                           Margin="8,0,8,0">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}"/>
                                                            <Setter Property="FontWeight" Value="Normal"/>
                                                            <Setter Property="FontSize" Value="13"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
                                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>

                                                <!-- Close tab button -->
                                                <Button Grid.Column="3" Style="{StaticResource TabCloseButton}" Click="CloseTabButton_Click"
                                                        AutomationProperties.Name="Close tab"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>

                    <!-- Pages -->
                    <ListBox x:Name="ThumbnailList" Grid.Row="1" ItemsSource="{Binding Thumbnails}" Padding="0,0,0,12"
                             Visibility="{Binding IsThumbnailsPanel, Converter={StaticResource BoolToVisibility}}"
                             SelectionChanged="ThumbnailList_SelectionChanged" AutomationProperties.Name="Page thumbnails">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                <Setter Property="Padding" Value="8,10,8,8"/>
                                <Setter Property="Margin" Value="10,2"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="vm:ThumbnailItem">
                                <views:ThumbnailHost>
                                    <Border Width="{Binding Width}" Height="{Binding Height}" Background="White" BorderBrush="{DynamicResource Brush.BorderStrong}" BorderThickness="1">
                                        <Image Source="{Binding Image}" Stretch="Fill" RenderOptions.BitmapScalingMode="HighQuality"/>
                                    </Border>
                                    <TextBlock Text="{Binding Label}" HorizontalAlignment="Center" Margin="0,6,0,0" Style="{StaticResource Caption}"/>
                                </views:ThumbnailHost>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Chapters -->
                    <Grid Grid.Row="1" Visibility="{Binding IsChaptersPanel, Converter={StaticResource BoolToVisibility}}">
                        <TreeView x:Name="OutlineTree" ItemsSource="{Binding Outline}" SelectedItemChanged="OutlineTree_SelectedItemChanged"
                                  PreviewMouseLeftButtonUp="OutlineTree_PreviewMouseLeftButtonUp" KeyDown="OutlineTree_KeyDown" AutomationProperties.Name="Chapters">
                            <TreeView.ItemContainerStyle>
                                <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                                    <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                                </Style>
                            </TreeView.ItemContainerStyle>
                            <TreeView.ItemTemplate>
                                <HierarchicalDataTemplate DataType="vm:OutlineNode" ItemsSource="{Binding Children}">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding PageLabel}" Style="{StaticResource Caption}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="Title" Text="{Binding Title}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}" VerticalAlignment="Center"/>
                                    </DockPanel>
                                    <HierarchicalDataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                            <Setter TargetName="Title" Property="FontWeight" Value="SemiBold"/>
                                            <Setter TargetName="Title" Property="Foreground" Value="{DynamicResource Brush.Accent}"/>
                                        </DataTrigger>
                                    </HierarchicalDataTemplate.Triggers>
                                </HierarchicalDataTemplate>
                            </TreeView.ItemTemplate>
                        </TreeView>
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="28" Visibility="{Binding HasOutline, Converter={StaticResource InverseBoolToVisibility}}">
                            <TextBlock Text="&#xE8FD;" Style="{StaticResource Icon}" FontSize="32" Foreground="{DynamicResource Brush.TextTertiary}"/>
                            <TextBlock Text="No chapters" Style="{StaticResource EmptyStateTitle}"/>
                            <TextBlock Text="This document doesn't include a table of contents." Style="{StaticResource Caption}" TextWrapping="Wrap" TextAlignment="Center"/>
                        </StackPanel>
                    </Grid>

                    <!-- Search -->
                    <DockPanel Grid.Row="1" Visibility="{Binding IsSearchPanel, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel DockPanel.Dock="Top" Margin="12,0,12,6">
                            <Grid>
                                <TextBox x:Name="SearchBox" Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" Padding="30,5,30,5"
                                         KeyDown="SearchBox_KeyDown" AutomationProperties.Name="Search text"/>
                                <TextBlock Text="&#xE721;" Style="{StaticResource Icon}" FontSize="13" HorizontalAlignment="Left" Margin="10,0,0,0"
                                           Foreground="{DynamicResource Brush.TextSecondary}" IsHitTestVisible="False"/>
                                <Button Style="{StaticResource IconButton}" Width="26" Height="24" FontSize="10" Content="&#xE711;" HorizontalAlignment="Right" Margin="0,0,3,0"
                                        Click="ClearSearch_Click" Visibility="{Binding SearchQuery, Converter={StaticResource NullToVisibility}}" ToolTip="Clear" AutomationProperties.Name="Clear search"/>
                            </Grid>
                            <WrapPanel Margin="0,6,0,0">
                                <CheckBox Content="Match case" IsChecked="{Binding MatchCase}" Margin="0,4,16,4" Click="SearchOption_Click"/>
                                <CheckBox Content="Whole words" IsChecked="{Binding WholeWord}" Click="SearchOption_Click"/>
                            </WrapPanel>
                            <DockPanel Margin="0,4,0,0">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Button Style="{StaticResource IconButton}" Width="30" Height="28" FontSize="12" Content="&#xE70E;" Click="PreviousHit_Click" ToolTip="Previous result (Shift+F3)" AutomationProperties.Name="Previous result"/>
                                    <Button Style="{StaticResource IconButton}" Width="30" Height="28" FontSize="12" Content="&#xE70D;" Click="NextHit_Click" ToolTip="Next result (F3)" AutomationProperties.Name="Next result"/>
                                </StackPanel>
                                <TextBlock Text="{Binding SearchStatus}" Style="{StaticResource Caption}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            </DockPanel>
                            <ProgressBar Maximum="1" Value="{Binding SearchProgress}" Height="2" Margin="0,6,0,0" Visibility="{Binding IsSearching, Converter={StaticResource BoolToVisibility}}"/>
                        </StackPanel>
                        <ListBox x:Name="SearchResultsList" ItemsSource="{Binding SearchResults}" SelectionChanged="SearchResults_SelectionChanged" AutomationProperties.Name="Search results">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="vm:SearchResultItem">
                                    <StackPanel>
                                        <TextBlock Text="{Binding PageLabel}" Style="{StaticResource Caption}" FontSize="11"/>
                                        <TextBlock TextWrapping="Wrap" Margin="0,2,0,0">
                                            <Run Text="{Binding Before, Mode=OneTime}"/><Run Text="{Binding MatchText, Mode=OneTime}" FontWeight="Bold" Background="{DynamicResource Brush.AccentSubtle}"/><Run Text="{Binding After, Mode=OneTime}"/>
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>

                    <!-- Annotations -->
                    <DockPanel Grid.Row="1" Visibility="{Binding IsAnnotationsPanel, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock DockPanel.Dock="Top" Text="{Binding AnnotationsStatus}" Style="{StaticResource Caption}" Margin="16,0,16,8"/>
                        <Button DockPanel.Dock="Bottom" Margin="12" Click="ExportAnnotations_Click" HorizontalAlignment="Stretch" AutomationProperties.Name="Export annotations">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8A7;" Style="{StaticResource Icon}" FontSize="14"/>
                                <TextBlock Text="Export to Markdown" Margin="8,0,0,0"/>
                            </StackPanel>
                        </Button>
                        <ListBox x:Name="AnnotationsList" ItemsSource="{Binding Annotations}" SelectionChanged="AnnotationsList_SelectionChanged"
                                 KeyDown="AnnotationsList_KeyDown" AutomationProperties.Name="Annotations list">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="vm:AnnotationItem">
                                    <DockPanel>
                                        <Border DockPanel.Dock="Left" Width="4" CornerRadius="2" Background="{Binding ColorBrush}" Margin="0,2,10,2"/>
                                        <StackPanel>
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding PageLabel}" Style="{StaticResource Caption}" FontSize="11"/>
                                                <TextBlock Text="{Binding KindLabel}" Style="{StaticResource Caption}" FontSize="11"/>
                                            </DockPanel>
                                            <TextBlock Text="{Binding Text}" TextWrapping="Wrap" MaxHeight="58" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Grid>
            </Border>

            <GridSplitter x:Name="SidebarSplitter" Grid.Column="2" Width="5" HorizontalAlignment="Center" ResizeBehavior="PreviousAndNext" DragCompleted="SidebarSplitter_DragCompleted"/>

            <!-- Document area -->
            <Grid x:Name="DocumentArea" Grid.Column="3" Background="{DynamicResource Brush.Canvas}">
                <viewer:PdfViewer x:Name="Viewer" Visibility="{Binding HasDocument, Converter={StaticResource BoolToVisibility}}"/>

                <!-- Welcome -->
                <ScrollViewer x:Name="WelcomeView" Visibility="{Binding HasDocument, Converter={StaticResource InverseBoolToVisibility}}" VerticalScrollBarVisibility="Auto">
                    <StackPanel MaxWidth="600" Margin="40,72,40,40" HorizontalAlignment="Center">
                        <Border Width="64" Height="64" CornerRadius="16" Background="{DynamicResource Brush.Accent}" HorizontalAlignment="Left">
                            <TextBlock Text="&#xE8A5;" Style="{StaticResource Icon}" FontSize="30" Foreground="{DynamicResource Brush.OnAccent}"/>
                        </Border>
                        <TextBlock Text="{x:Static infra:AppInfo.Name}" FontSize="34" FontWeight="SemiBold" Margin="0,20,0,4"/>
                        <TextBlock Text="A fast, private reader for PDFs and scanned images. Everything, including text recognition, stays on this device."
                                   Style="{StaticResource Caption}" FontSize="14" TextWrapping="Wrap"/>
                        <StackPanel Orientation="Horizontal" Margin="0,28,0,0">
                            <Button Style="{StaticResource AccentButton}" Click="Open_Click" Padding="18,8" AutomationProperties.Name="Open file">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8E5;" Style="{StaticResource Icon}" FontSize="14"/>
                                    <TextBlock Text="Open file…" Margin="10,0,0,0"/>
                                </StackPanel>
                            </Button>
                            <Button Margin="8,0,0,0" Click="PasteImage_Click" Padding="14,8" ToolTip="Open an image from the clipboard (Ctrl+V)" AutomationProperties.Name="Paste image">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE77F;" Style="{StaticResource Icon}" FontSize="14"/>
                                    <TextBlock Text="Paste image" Margin="10,0,0,0"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <TextBlock Text="or drop a PDF or image anywhere in this window" Style="{StaticResource Caption}" Margin="0,12,0,0"/>

                        <TextBlock Text="Recent" Style="{StaticResource SectionTitle}" Margin="0,44,0,8" x:Name="RecentHeader"/>
                        <ItemsControl ItemsSource="{Binding RecentFiles}" x:Name="RecentList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="vm:RecentItem">
                                    <Button Click="Recent_Click" HorizontalContentAlignment="Stretch" Padding="10,8" Margin="-10,1" BorderThickness="0"
                                            Background="Transparent" ToolTip="{Binding Path}" AutomationProperties.Name="{Binding FileName}">
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Width="28" Height="28" FontSize="10" Content="&#xE711;"
                                                    Click="RemoveRecent_Click" ToolTip="Remove from list" AutomationProperties.Name="Remove from recent"/>
                                            <TextBlock DockPanel.Dock="Left" Text="&#xE8A5;" Style="{StaticResource Icon}" FontSize="20" Margin="0,0,14,0" Foreground="{DynamicResource Brush.Accent}"/>
                                            <StackPanel>
                                                <TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </DockPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="Keyboard" Style="{StaticResource SectionTitle}" Margin="0,36,0,8"/>
                        <TextBlock Style="{StaticResource Caption}" LineHeight="22" TextWrapping="Wrap">
                            Ctrl+O open · Ctrl+F search · Ctrl+C copy · Ctrl+H highlight · Ctrl+S save<LineBreak/>
                            Ctrl+wheel zoom · Ctrl+1 fit width · Ctrl+2 fit page · F4 sidebar · F11 full screen
                        </TextBlock>
                    </StackPanel>
                </ScrollViewer>

                <!-- Scanned page banner -->
                <Border Style="{StaticResource Card}" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="16,16,16,0" Padding="14,10"
                        Background="{DynamicResource Brush.Info}" BorderBrush="{DynamicResource Brush.InfoBorder}"
                        Visibility="{Binding IsScanBannerVisible, Converter={StaticResource BoolToVisibility}}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Left" Text="&#xEE6F;" Style="{StaticResource Icon}" FontSize="20" Foreground="{DynamicResource Brush.Accent}" Margin="2,0,12,0"/>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="16,0,0,0">
                            <Button Style="{StaticResource AccentButton}" Content="Recognize page" Click="OcrPage_Click"/>
                            <Button Content="All pages" Margin="8,0,0,0" Click="OcrAll_Click"/>
                            <Button Style="{StaticResource IconButton}" Content="&#xE711;" FontSize="11" Width="30" Height="30" Margin="6,0,0,0" Click="DismissBanner_Click" ToolTip="Dismiss" AutomationProperties.Name="Dismiss"/>
                        </StackPanel>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="This page has no selectable text" FontWeight="SemiBold"/>
                            <TextBlock Text="Recognize the text to select, copy, search and highlight it." Style="{StaticResource Caption}"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Long-running task progress (recognition, conversion) -->
                <Border Style="{StaticResource Card}" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,0,30,24" Width="310" Padding="16,12"
                        Visibility="{Binding IsTaskRunning, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Cancel" Click="CancelTask_Click" Padding="12,2" MinHeight="28"/>
                            <TextBlock Text="{Binding TaskTitle}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </DockPanel>
                        <TextBlock Text="{Binding TaskProgressText}" Style="{StaticResource Caption}" Margin="0,6,0,10"/>
                        <ProgressBar Maximum="1" Value="{Binding TaskProgress}"/>
                    </StackPanel>
                </Border>

                <!-- Toast -->
                <Border x:Name="Toast" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,28" Padding="16,9" CornerRadius="8"
                        Background="{DynamicResource Brush.Toast}" IsHitTestVisible="False" Visibility="{Binding IsToastVisible, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{Binding ToastText}" Foreground="{DynamicResource Brush.OnToast}"/>
                </Border>

                <!-- Busy overlay -->
                <Grid Background="#33000000" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
                    <Border Style="{StaticResource Card}" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24,18">
                        <TextBlock Text="{Binding BusyText}" FontWeight="SemiBold"/>
                    </Border>
                </Grid>
            </Grid>

            <!-- Drop overlay -->
            <Border x:Name="DropOverlay" Grid.ColumnSpan="4" Background="{DynamicResource Brush.DropOverlay}" Visibility="Collapsed" IsHitTestVisible="False">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="&#xE8E5;" Style="{StaticResource Icon}" FontSize="48" Foreground="White"/>
                    <TextBlock Text="Drop to open" FontSize="22" FontWeight="SemiBold" Foreground="White" Margin="0,14,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ===== Status bar ===== -->
        <Border x:Name="StatusBar" Grid.Row="2" Background="{DynamicResource Brush.Chrome}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0" Padding="14,5"
                Visibility="{Binding HasDocument, Converter={StaticResource BoolToVisibility}}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <TextBlock Text="{Binding TextSourceText}" Style="{StaticResource Caption}" Margin="0,0,18,0"/>
                    <TextBlock Text="{Binding ZoomText}" Style="{StaticResource Caption}"/>
                </StackPanel>
                <TextBlock Text="{Binding PageStatusText}" Style="{StaticResource Caption}" Margin="0,0,18,0"/>
                <TextBlock Text="{Binding StatusText}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
