<Window x:Class="LitePdf.App.Views.TextWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Text" Height="400" Width="600"
        WindowStartupLocation="CenterOwner">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBox x:Name="TextBox" Grid.Row="0" AcceptsReturn="True" AcceptsTab="True"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                 IsReadOnly="True" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12"
                 Margin="8"/>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="8">
            <Button Content="Copy" Width="80" Margin="0,0,8,0" Click="Copy_Click"/>
            <Button Content="Close" Width="80" IsDefault="True" Click="Close_Click"/>
        </StackPanel>
    </Grid>
</Window>
