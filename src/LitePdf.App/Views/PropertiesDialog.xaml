<Window x:Class="LitePdf.App.Views.PropertiesDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Document Properties" Height="300" Width="400"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="120"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Text="File:" Grid.Row="0" Grid.Column="0" Margin="0,4" FontWeight="Bold"/>
        <TextBlock x:Name="FileNameText" Grid.Row="0" Grid.Column="1" Margin="0,4" TextWrapping="Wrap"/>

        <TextBlock Text="Pages:" Grid.Row="1" Grid.Column="0" Margin="0,4" FontWeight="Bold"/>
        <TextBlock x:Name="PageCountText" Grid.Row="1" Grid.Column="1" Margin="0,4"/>

        <TextBlock Text="Page size:" Grid.Row="2" Grid.Column="0" Margin="0,4" FontWeight="Bold"/>
        <TextBlock x:Name="PageSizeText" Grid.Row="2" Grid.Column="1" Margin="0,4"/>

        <TextBlock Text="Doc key:" Grid.Row="3" Grid.Column="0" Margin="0,4" FontWeight="Bold"/>
        <TextBlock x:Name="DocKeyText" Grid.Row="3" Grid.Column="1" Margin="0,4" TextWrapping="Wrap" FontSize="10"/>

        <Button Content="Close" Grid.Row="5" Grid.Column="1" HorizontalAlignment="Right" Width="80" IsDefault="True" Click="Close_Click"/>
    </Grid>
</Window>
