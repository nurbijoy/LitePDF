<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>LitePDF</AssemblyName>
    <RootNamespace>LitePdf.App</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Lite footprint: workstation GC that returns memory to the OS promptly. -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <TieredPGO>true</TieredPGO>


    <!-- Shown by Explorer, the taskbar, Start menu and the installer. -->
    <ApplicationIcon>Assets\LitePDF.ico</ApplicationIcon>
    <!-- Product is the display name: AppInfo reads it, so this is the one place the app is named.
         AssemblyName stays LitePDF (no space): it is the exe name, the ProgID and the WPF resource URI. -->
    <Product>Lite PDF</Product>
    <AssemblyTitle>Lite PDF</AssemblyTitle>
    <Company>Nur Innovative Solutions</Company>
    <Description>A lightweight, private PDF and scan reader for Windows.</Description>
    <Copyright>Copyright (c) 2026 Nur Innovative Solutions</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\LitePDF.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LitePdf.Core\LitePdf.Core.csproj" />
    <ProjectReference Include="..\LitePdf.Pdfium\LitePdf.Pdfium.csproj" />
    <ProjectReference Include="..\LitePdf.Ocr\LitePdf.Ocr.csproj" />
  </ItemGroup>

  <Target Name="AutoIncrementBuildVersion" BeforeTargets="GetAssemblyVersion">
    <PropertyGroup>
      <VersionFile>$(MSBuildProjectDirectory)\version.txt</VersionFile>
    </PropertyGroup>

    <ReadLinesFromFile File="$(VersionFile)" Condition="Exists('$(VersionFile)')">
      <Output TaskParameter="Lines" PropertyName="_StoredVer" />
    </ReadLinesFromFile>

    <PropertyGroup>
      <_StoredVer>$([System.String]::Copy('$(_StoredVer)').Trim())</_StoredVer>
      <_StoredVer Condition="'$(_StoredVer)' == ''">1.0</_StoredVer>

      <_FileMajor>$(_StoredVer.Split('.')[0])</_FileMajor>
      <_FileMinor Condition="$(_StoredVer.Contains('.'))">$(_StoredVer.Split('.')[1])</_FileMinor>
      <_FileMinor Condition="'$(_FileMinor)' == ''">0</_FileMinor>

      <_CurrentVersion>$(_FileMajor).$(_FileMinor)</_CurrentVersion>

      <_NextMinor Condition="'$(NoIncrement)' != 'true'">$([MSBuild]::Add($(_FileMinor), 1))</_NextMinor>
      <_NextMinor Condition="'$(NoIncrement)' == 'true'">$(_FileMinor)</_NextMinor>
      <_NextVersion>$(_FileMajor).$(_NextMinor)</_NextVersion>

      <Version>$(_CurrentVersion).0</Version>
      <AssemblyVersion>$(_CurrentVersion).0.0</AssemblyVersion>
      <FileVersion>$(_CurrentVersion).0.0</FileVersion>
      <InformationalVersion>$(_CurrentVersion)</InformationalVersion>
    </PropertyGroup>

    <WriteLinesToFile File="$(VersionFile)" Lines="$(_NextVersion)" Overwrite="true" Condition="'$(NoIncrement)' != 'true'" />
    <Message Importance="High" Text="[Build Version] $(_CurrentVersion) (next: $(_NextVersion))" />
  </Target>
</Project>
