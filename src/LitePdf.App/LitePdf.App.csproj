<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>LitePDF</AssemblyName>
    <RootNamespace>LitePdf.App</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Lite footprint: workstation GC that returns memory to the OS promptly. -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <TieredPGO>true</TieredPGO>
    <Version>1.1.0</Version>

    <!-- Shown by Explorer, the taskbar, Start menu and the installer. -->
    <ApplicationIcon>Assets\LitePDF.ico</ApplicationIcon>
    <!-- Product is the display name: AppInfo reads it, so this is the one place the app is named.
         AssemblyName stays LitePDF (no space): it is the exe name, the ProgID and the WPF resource URI. -->
    <Product>Lite PDF</Product>
    <AssemblyTitle>Lite PDF</AssemblyTitle>
    <Company>Nur Innovative Solutions</Company>
    <Description>A lightweight, private PDF and scan reader for Windows.</Description>
    <Copyright>Copyright (c) 2026 Nur Innovative Solutions</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\LitePDF.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LitePdf.Core\LitePdf.Core.csproj" />
    <ProjectReference Include="..\LitePdf.Pdfium\LitePdf.Pdfium.csproj" />
    <ProjectReference Include="..\LitePdf.Ocr\LitePdf.Ocr.csproj" />
  </ItemGroup>

</Project>
